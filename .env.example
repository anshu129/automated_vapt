DATABASE_URL=postgresql+asyncpg://vapt:vapt@localhost:5432/vapt
DATABASE_URL_SYNC=postgresql+psycopg://vapt:vapt@localhost:5432/vapt

# Optional advisory enrichment. Keep disabled until a key is configured.
AI_ENABLED=false
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
AI_MAX_TOKENS=0
AI_TIMEOUT_SECONDS=45

# Optional read-only MCP server (this platform exposing assessment data).
MCP_ENABLED=false
MCP_READ_ONLY=true

# Optional MCP *clients* for tool validation (Burp / sqlmap).
# Burp: load PortSwigger MCP extension in Burp Pro; enable MCP tab; default SSE http://127.0.0.1:9876
# Note: mcp-proxy.jar is only for stdio clients (Claude Desktop) — this platform uses SSE directly.
BURP_MCP_ENABLED=false
BURP_MCP_SSE_URL=http://127.0.0.1:9876

# SQLMap MCP: clone https://github.com/mohdhaji87/SQLMap-MCP and point to server.py
SQLMAP_MCP_ENABLED=false
SQLMAP_MCP_SERVER_PATH=
SQLMAP_MCP_COMMAND=python
SQLMAP_MCP_EXTRA_ARGS=

# Scan pipeline: inline recon on API scan-start; UI scans use UI_SCAN_INLINE_RECON separately.
SCAN_START_INLINE_EXECUTION=false
UI_SCAN_INLINE_RECON=true

# Phase 5 — assessment completion (job status separated from assessment status).
ASSESSMENT_COMPLETION_V2=true
PENDING_WORK_AWARE_COMPLETION=true
BIND_JOB_STATUS_TO_ASSESSMENT=false

# Phase 6 — UI/report status sync + completion history.
PHASE6_STATUS_SYNC_ENABLED=true
PHASE6_COMPLETION_HISTORY_ENABLED=true
PHASE6_REPORT_COMPLETION_PAYLOAD=true

# Phase 7 — requirement granularity, report snapshots, latest transition denorm.
PHASE7_REQUIREMENT_GRANULARITY_ENABLED=true
PHASE7_REPORT_SNAPSHOTS_ENABLED=true
PHASE7_LATEST_TRANSITION_DENORMALIZED=true
PHASE7_LEGACY_REQUIREMENT_MERGE_ONLY=false

# Phase 8 — report artifacts, staleness, test plan uniqueness, SQLite migration.
PHASE8_REPORT_ARTIFACT_STORAGE_ENABLED=true
PHASE8_REPORT_STALENESS_DETECTION_ENABLED=true
PHASE8_TESTPLAN_UNIQUENESS_ENABLED=true
PHASE8_SQLITE_MIGRATION_HARDENING_ENABLED=true
REPORT_ARTIFACT_ROOT=data/report_artifacts

# Phase 9 — pluggable artifact backend, retention, staleness polling, plan splitting.
PHASE9_ARTIFACT_BACKEND_ENABLED=true
PHASE9_ARTIFACT_RETENTION_ENABLED=true
PHASE9_STALENESS_POLLING_ENABLED=true
PHASE9_STALENESS_FULL_HASH_FALLBACK_ENABLED=true
PHASE9_PLAN_SPLITTING_ENABLED=true
PHASE9_INTEGRITY_AUDIT_ENABLED=true
PHASE9_SQLITE_MIGRATION_COMMAND_ENABLED=true
REPORT_ARTIFACT_BACKEND=filesystem
REPORT_ARTIFACT_MAX_VERSIONS_PER_SCAN=10
REPORT_ARTIFACT_TTL_DAYS=90
REPORT_ARTIFACT_KEEP_LATEST=true
REPORT_ARTIFACT_KEEP_TERMINAL=true
REPORT_STALENESS_POLL_INTERVAL_SECONDS=30

